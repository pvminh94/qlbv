# ═══════════════════════════════════════════════════════════════════════════════
#  QLBS — Cấu hình backend
#  Sao chép tệp này thành .env rồi sửa các giá trị cho phù hợp.
#  TUYỆT ĐỐI không đưa .env thật lên Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ---------------------------------------------------------------- Ứng dụng
NODE_ENV=development
APP_NAME=QLBS — Phần mềm Quản lý Bệnh viện
PORT=4000
HOST=0.0.0.0
API_PREFIX=api
# Danh sách nguồn được phép gọi API, cách nhau bởi dấu phẩy. '*' = tất cả (chỉ dùng khi phát triển)
CORS_ORIGINS=http://localhost:3000
# Tích hợp máy khoá phòng khám (API chỉ đọc lịch trực). Trống = chỉ kiểm tra khoá API.
# Đặt địa chỉ IP máy chủ mở khoá để chặn mọi nơi khác, ví dụ: INTEGRATION_ALLOWED_IPS=203.0.113.10
INTEGRATION_ALLOWED_IPS=
# Địa chỉ Microservice AI (VPS 2) xác thực sinh trắc học và chống giả mạo ISO 30107 PAD
AI_SERVICE_URL=http://localhost:8001
SWAGGER_ENABLED=true
TZ=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------- CSDL PostgreSQL
# Chạy bằng Docker:  postgresql://qlbs:mat_khau@postgres:5432/qlbs
# Chạy trực tiếp  :  postgresql://qlbs:mat_khau@localhost:5432/qlbs
DATABASE_URL=postgresql://qlbs:qlbs@localhost:5432/qlbs
DB_POOL_MAX=12
DB_CONNECTION_TIMEOUT_MS=10000
DB_LOG_QUERIES=false
DB_SSL=false

# ---------------------------------------------------------------- Redis & bộ đệm
# CACHE_DRIVER=redis  → dùng Redis (khuyến nghị cho production)
# CACHE_DRIVER=memory → cache trong bộ nhớ tiến trình (chạy thử, 1 tiến trình)
CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=qlbs:
CACHE_TTL=60
CACHE_STRUCTURE_TTL=600
CACHE_PERMISSION_TTL=300

# ---------------------------------------------------------------- Hàng đợi & tác vụ định kỳ
# QUEUE_DRIVER=bullmq → hàng đợi Redis, chạy nhiều tiến trình, bền vững (production)
# QUEUE_DRIVER=inline → chạy trong tiến trình (chạy thử)
QUEUE_DRIVER=bullmq
QUEUE_PREFIX=qlbs
QUEUE_CONCURRENCY=4
QUEUE_AUTO_SCHEDULE=true

# ---------------------------------------------------------------- Bảo mật
# BẮT BUỘC đổi hai chuỗi dưới đây trước khi triển khai thật:
#   openssl rand -hex 48
JWT_SECRET=doi-chuoi-nay-truoc-khi-dung-that-qlbs
JWT_REFRESH_SECRET=doi-chuoi-nay-truoc-khi-dung-that-qlbs-refresh
JWT_ISSUER=qlbs
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=12h
BCRYPT_ROUNDS=10
SESSION_HOURS=12
MAX_FAILED_LOGINS=8
LOCK_MINUTES=15

# ---------------------------------------------------------------- Lưu trữ tệp
STORAGE_DIR=./.data/storage
EXPORTS_DIR=./.data/exports
BACKUPS_DIR=./.data/backups
UPLOAD_MAX_MB=25
STORAGE_RETENTION_DAYS=30

# ---------------------------------------------------------------- Tài khoản quản trị khởi tạo
# Chỉ dùng cho lần chạy `npm run db:seed` đầu tiên.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=Admin@123
SEED_ADMIN_NAME=Quản trị hệ thống
SEED_DEMO_DATA=true

# ---------------------------------------------------------------- Phân trang
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200
