## Cấu hình triển khai QLBS (dùng cho docker compose)
##
## Sao chép thành .env rồi ĐỔI MẬT KHẨU trước khi chạy thật:
##   cp .env.example .env
##
## Biến dưới đây chỉ dành cho docker compose. Cấu hình chi tiết của từng dịch vụ
## nằm ở backend/.env (xem backend/.env.example).

# Mật khẩu PostgreSQL (bắt buộc đổi)
POSTGRES_PASSWORD=doi-mat-khau-ngay

# Mật khẩu Redis (bắt buộc đổi; Redis không mở ra ngoài internet)
REDIS_PASSWORD=doi-mat-khau-redis

# Khoá ký JWT — BẮT BUỘC đổi, dùng chuỗi ngẫu nhiên dài ≥ 32 ký tự
JWT_SECRET=doi-chuoi-nay-truoc-khi-dung-that-qlbs
JWT_REFRESH_SECRET=doi-chuoi-nay-truoc-khi-dung-that-qlbs-refresh

# Tài khoản quản trị tạo ở lần chạy đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Quản trị hệ thống

# Cổng mở ra ngoài
WEB_PORT=3000
API_PORT=4000

# Nơi lưu tệp tải lên và bản sao lưu (đường dẫn trên máy chủ)
UPLOAD_HOST_DIR=./data/uploads
BACKUP_HOST_DIR=./data/backups
POSTGRES_HOST_DIR=./data/postgres
REDIS_HOST_DIR=./data/redis

# Tên miền được phép gọi API (nhiều giá trị cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000

# Địa chỉ Microservice AI (VPS 2) xác thực sinh trắc học và chống giả mạo
AI_SERVICE_URL=http://localhost:8001
